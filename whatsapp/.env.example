# Copy this file to .env and fill in the values.
# .env.example is committed to the repository: never put a real key or password in it.
# Only the settings this project needs are listed; anything else keeps the default from the code.

# --- Server ---
PORT=8081
HOST=0.0.0.0
CHATBOT_MODE=standalone

# --- AI: Google Gemini (create a key at https://aistudio.google.com/apikey) ---
# Free tier; current rate limits are listed at https://github.com/mnfst/awesome-free-llm-apis
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
# Optional thinking level for larger models (e.g. minimal with gemini-3.6-flash). Leave empty with Flash-Lite.
GEMINI_REASONING_EFFORT=
AI_DEBUG=0
AI_REPLY_IN_GROUPS=false
AI_REPLY_TO_MEDIA=false

# --- Voice notes ---
AI_REPLY_TO_AUDIO=true
AI_VOICE_ARCHIVE_AUDIO=false
# Speech-to-text model for voice notes.
VOICE_TRANSCRIPTION_MODEL=gemini-3.5-transcribe

# --- Dashboard login (used only when the first admin account is created) ---
DASHBOARD_USERNAME=admin
DASHBOARD_PASSWORD=HelDashboard2026

# --- Security: protects /incoming and the internal /instance/* routes ---
WEBHOOK_SECRET=change_this_webhook_secret
WHATSAPP_SERVICE_TOKEN=change_this_service_token

# --- CRM ---
CRM_DB_PATH=./storage/crm.sqlite
# WhatsApp chat that receives a message for each new booking (empty = disabled).
CRM_STAFF_NOTIFY_CHAT_ID=

# --- WhatsApp ---
WA_SESSION_PATH=./storage/wa-auth
# Path to Chrome when it is not found automatically (the Docker image sets it).
PUPPETEER_EXECUTABLE_PATH=
