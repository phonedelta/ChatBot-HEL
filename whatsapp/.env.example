PORT=8081
HOST=0.0.0.0
WHATSAPP_PROVIDER=custom
CHATBOT_MODE=standalone
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-5.6-luna
OPENAI_SYSTEM_PROMPT=You are a helpful business assistant on WhatsApp. Reply in the same language as the user. Be concise, natural, and accurate. Never claim to have completed an external action that you cannot perform. Ask one brief clarifying question when necessary.
AI_KNOWLEDGE_PATH=./src/knowledge/centre-dentaire-hel.md
OPENAI_REASONING_EFFORT=low
OPENAI_TIMEOUT_MS=45000
OPENAI_MAX_OUTPUT_TOKENS=500
AI_HISTORY_LIMIT=12
AI_MAX_INPUT_CHARACTERS=4000
AI_HISTORY_PATH=./storage/ai-conversations.json
AI_REPLY_IN_GROUPS=false
AI_REPLY_TO_MEDIA=false
AI_REPLY_TO_AUDIO=true
AI_AUDIO_ENHANCE=true
AI_VOICE_NLU_ENABLED=true
AI_VOICE_NLU_LOG_DIR=./storage/voice-nlu-logs
AI_VOICE_ARCHIVE_AUDIO=true
OPENAI_TRANSCRIBE_MODEL=openai/whisper-large-v3
OPENAI_TRANSCRIBE_FALLBACK_MODEL=openai/whisper-1
OPENAI_TRANSCRIBE_BASE_URL=
OPENAI_TRANSCRIBE_API_KEY=
OPENAI_TRANSCRIBE_PROMPT=Message vocal d'un patient pour un centre dentaire au Maroc. Langues: français et darija marocaine.
OPENAI_TRANSCRIBE_DARIJA_PROMPT=تسجيل صوتي لمريض عيادة أسنان بالمغرب باللهجة الدارجة المغربية.
AI_RESET_COMMAND=/reset
AI_RESET_REPLY=Conversation reset. How can I help you?
AI_ERROR_REPLY=Sorry, I cannot answer right now. Please try again in a few moments.
AI_AUDIO_ERROR_REPLY=Désolé, je n'ai pas pu comprendre ce message vocal. Pouvez-vous réessayer ou écrire votre message en français ou en darija ?
WEBHOOK_SECRET=change_this_webhook_secret
API_BASE_URL=http://127.0.0.1:8000/api
WHATSAPP_SERVICE_TOKEN=change_this_service_token
DASHBOARD_USERNAME=admin
DASHBOARD_PASSWORD=HelDashboard2026
DASHBOARD_AUTH_PATH=./storage/dashboard-auth.json
CRM_ENABLED=true
CRM_DB_PATH=./storage/crm.sqlite
CRM_STAFF_NOTIFY_CHAT_ID=
# Smart CRM — HEL default: patient confirms request, staff confirms appointment
# staff_required | patient_confirmation_allowed
CRM_CONFIRMATION_POLICY=staff_required
REQUEST_TIMEOUT_MS=15000
WA_AUTO_START=true
WA_SESSION_PATH=./storage/wa-auth
WA_QR_WAIT_MS=7000
# Optional: prefer phone pairing code instead of QR (Android “link with number”)
# WA_PAIR_PHONE=212612345678
# Railway / Docker: use 60000+ for first QR on cold start
# WA_QR_WAIT_MS=60000
WA_RECONNECT_DELAY_MS=5000
PUPPETEER_EXECUTABLE_PATH=
# Railway Docker image sets /usr/bin/chromium automatically
# PUPPETEER_EXECUTABLE_PATH=/usr/bin/chromium
WA_PUPPETEER_ARGS=--no-sandbox,--disable-setuid-sandbox,--disable-dev-shm-usage,--disable-gpu
# Railway recommended:
# WA_PUPPETEER_ARGS=--no-sandbox,--disable-setuid-sandbox,--disable-dev-shm-usage,--disable-gpu,--headless=new,--no-zygote,--disable-extensions
