PORT=8081
CHATBOT_MODE=standalone
WHATSAPP_PROVIDER=custom
WA_AUTO_START=true

OPENAI_API_KEY=COLLER_TA_CLE_OPENROUTER
OPENAI_BASE_URL=https://openrouter.ai/api/v1
OPENAI_MODEL=openai/gpt-5.6-luna

AI_REPLY_IN_GROUPS=false
AI_REPLY_TO_MEDIA=false
AI_REPLY_TO_AUDIO=true
AI_AUDIO_ENHANCE=true
AI_VOICE_NLU_ENABLED=true
AI_VOICE_NLU_LOG_DIR=./storage/voice-nlu-logs
AI_VOICE_ARCHIVE_AUDIO=true
AI_HISTORY_LIMIT=12
AI_HISTORY_PATH=./storage/ai-conversations.json
AI_KNOWLEDGE_PATH=./src/knowledge/centre-dentaire-hel.md
AI_RESET_COMMAND=/reset
AI_AUDIO_ERROR_REPLY=Désolé, je n'ai pas pu bien comprendre ce message vocal. Pouvez-vous répéter plus lentement, ou écrire votre message en français ou en darija ?
AI_AUDIO_UNCLEAR_REPLY=Je n'ai pas bien saisi votre message vocal. Pouvez-vous le répéter un peu plus clairement, ou l'écrire en français ou en darija ?

OPENAI_TRANSCRIBE_MODEL=openai/whisper-large-v3
OPENAI_TRANSCRIBE_FALLBACK_MODEL=openai/whisper-1

WHATSAPP_SERVICE_TOKEN=genere_un_token_long
WEBHOOK_SECRET=genere_un_secret_long

DASHBOARD_USERNAME=admin
DASHBOARD_PASSWORD=ChoisisUnMotDePasseFort
DASHBOARD_AUTH_PATH=./storage/dashboard-auth.json

CRM_ENABLED=true
CRM_DB_PATH=./storage/crm.sqlite
CRM_STAFF_NOTIFY_CHAT_ID=

WA_SESSION_PATH=./storage/sessions
WA_QR_WAIT_MS=7000
WA_RECONNECT_DELAY_MS=5000

PUPPETEER_EXECUTABLE_PATH=/usr/bin/chromium
WA_PUPPETEER_ARGS=--no-sandbox,--disable-setuid-sandbox,--disable-dev-shm-usage,--disable-gpu,--disable-extensions,--mute-audio
WA_INSTANCE_PING_TIMEOUT_MS=90000
WA_INSTANCE_PING_INTERVAL_MS=180000
WA_AUTOMATION_HISTORY_SYNC_ENABLED=false
WA_PROTOCOL_TIMEOUT_MS=600000

WA_MEDIA_TMP_DIR=/tmp/iadis-wa-media
WA_MEDIA_MAX_BYTES=15728640
WA_OUTBOUND_MEDIA_MAX_BYTES=157286400
